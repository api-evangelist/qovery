{
  "opencollection": "1.0.0",
  "info": {
    "name": "Qovery Account Info Environment Logs API",
    "version": "1.0.4"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Environment Logs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List environment deployment logs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.qovery.com/environment/:environmentId/log",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "Environment ID"
              }
            ]
          },
          "docs": "This returns the last 1000 environment deployment logs."
        },
        {
          "info": {
            "name": "List environment deployment logs v2",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.qovery.com/environment/:environmentId/logs",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "Environment ID"
              },
              {
                "name": "version",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "This returns the last 1000 environment deployment logs v2"
        }
      ]
    }
  ],
  "bundled": true
}