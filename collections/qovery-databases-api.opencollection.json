{
  "opencollection": "1.0.0",
  "info": {
    "name": "Qovery Account Info Databases API",
    "version": "1.0.4"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Databases",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List eligible database types, versions and modes for the environment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.qovery.com/environment/:environmentId/databaseConfiguration",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "Environment ID"
              }
            ]
          },
          "docs": "List eligible database types, versions and modes for the environment"
        },
        {
          "info": {
            "name": "List environment databases",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.qovery.com/environment/:environmentId/database",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "Environment ID"
              }
            ]
          },
          "docs": "List environment databases"
        },
        {
          "info": {
            "name": "Create a database",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.qovery.com/environment/:environmentId/database",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "Environment ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a database"
        },
        {
          "info": {
            "name": "List all environment databases statuses",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.qovery.com/environment/:environmentId/database/status",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "Environment ID"
              }
            ]
          },
          "docs": "Returns a list of databases with only their id and status."
        },
        {
          "info": {
            "name": "Clone database",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.qovery.com/database/:databaseId/clone",
            "params": [
              {
                "name": "databaseId",
                "value": "",
                "type": "path",
                "description": "Database ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This will create a new database with the same configuration on the targeted environment Id."
        }
      ]
    }
  ],
  "bundled": true
}