          "name": "Get git webhook status for a service",
          "request": {
            "name": "Get git webhook status for a service",
            "description": {
              "content": "Returns the webhook status for a git-based service. Checks if the Qovery webhook is correctly configured on the git provider (GitHub, GitLab, or Bitbucket).",
              "type": "text/plain"
            },
