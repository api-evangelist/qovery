        {
          "id": "e55e5d52-fab3-411d-bd6d-e0a21855fdaf",
          "name": "Synchronize git webhook for a service",
          "request": {
            "name": "Synchronize git webhook for a service",
            "description": {
              "content": "Synchronizes the Qovery webhook configuration for a git-based service.\n- If no webhook exists, creates one with the correct configuration\n- If webhook exists but is misconfigured, updates it with the correct events\n- If webhook is already correctly configured, returns current status\nWorks with GitHub, GitLab, and Bitbucket repositories.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "service",
                ":serviceId",
                "gitWebhook",
                "sync"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "serviceId",
                  "description": "(Required) Service ID of an application/job/container/database"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null
          },
          "response": [
            {
              "id": "5bc645ef-24f4-431a-bf03-48a8994b97a6",
              "name": "Webhook synchronized successfully",
