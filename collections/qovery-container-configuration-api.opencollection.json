{
  "opencollection": "1.0.0",
  "info": {
    "name": "Qovery Account Info Container Configuration API",
    "version": "1.0.4"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Container Configuration",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get advanced settings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.qovery.com/container/:containerId/advancedSettings",
            "params": [
              {
                "name": "containerId",
                "value": "",
                "type": "path",
                "description": "Container ID"
              }
            ]
          },
          "docs": "Get list and values of the advanced settings of the container.\nDefault values for each setting are available in [our documentation](https://hub.qovery.com/docs/using-qovery/configuration/advanced-settings/)\n"
        },
        {
          "info": {
            "name": "Edit advanced settings",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.qovery.com/container/:containerId/advancedSettings",
            "params": [
              {
                "name": "containerId",
                "value": "",
                "type": "path",
                "description": "Container ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Edit advanced settings by returning table of advanced settings."
        },
        {
          "info": {
            "name": "Get Container Network information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.qovery.com/container/:containerId/network",
            "params": [
              {
                "name": "containerId",
                "value": "",
                "type": "path",
                "description": "Container ID"
              }
            ]
          },
          "docs": "Get status of the container network settings."
        },
        {
          "info": {
            "name": "Edit Container Network",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.qovery.com/container/:containerId/network",
            "params": [
              {
                "name": "containerId",
                "value": "",
                "type": "path",
                "description": "Container ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Edit the Network settings of the container."
        }
      ]
    }
  ],
  "bundled": true
}