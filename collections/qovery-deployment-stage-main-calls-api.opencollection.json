{
  "opencollection": "1.0.0",
  "info": {
    "name": "Qovery Account Info Deployment Stage Main Calls API",
    "version": "1.0.4"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
