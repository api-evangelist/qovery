          "info": {
            "name": "List environment deployment stage",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.qovery.com/environment/:environmentId/deploymentStage",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "Environment ID"
              }
            ]
          },
          "docs": "List environment deployment stage"
        },
        {
          "info": {
            "name": "Create environment deployment stage",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.qovery.com/environment/:environmentId/deploymentStage",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "Environment ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
