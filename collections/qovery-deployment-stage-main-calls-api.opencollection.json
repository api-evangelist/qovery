        {
          "info": {
            "name": "Move deployment stage after requested stage",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.qovery.com/deploymentStage/:deploymentStageId/moveAfter/:stageId",
            "params": [
              {
                "name": "deploymentStageId",
                "value": "",
                "type": "path",
                "description": "Deployment Stage ID"
              },
              {
                "name": "stageId",
                "value": "",
                "type": "path",
                "description": "Deployment Stage ID"
              }
            ]
          },
