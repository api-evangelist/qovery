{
  "opencollection": "1.0.0",
  "info": {
    "name": "Qovery Account Info Terraform Main Calls API",
    "version": "1.0.4"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Terraform Main Calls",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get terraform by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.qovery.com/terraform/:terraformId",
            "params": [
              {
                "name": "terraformId",
                "value": "",
                "type": "path",
                "description": "Terraform ID"
              }
            ]
          },
          "docs": "Get terraform by ID"
        },
        {
          "info": {
            "name": "Edit Terraform",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.qovery.com/terraform/:terraformId",
            "params": [
              {
                "name": "terraformId",
                "value": "",
                "type": "path",
                "description": "Terraform ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Edit Terraform"
        },
        {
          "info": {
            "name": "Delete Terraform",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.qovery.com/terraform/:terraformId",
            "params": [
              {
                "name": "terraformId",
                "value": "",
                "type": "path",
                "description": "Terraform ID"
              },
              {
                "name": "resources_only",
                "value": "",
                "type": "query",
                "description": "When true, only resources are deleted and Qovery configuration is kept."
              },
              {
                "name": "force_terraform_action",
                "value": "",
                "type": "query",
                "description": "Force a specific action to be executed by Terraform during deletion."
              }
            ]
          },
          "docs": "Delete Terraform"
        },
        {
          "info": {
            "name": "List available Terraform versions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.qovery.com/terraform/availableVersion"
          },
          "docs": "List available Terraform versions"
        },
        {
          "info": {
            "name": "List last commits",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.qovery.com/terraform/:terraformId/commit",
            "params": [
              {
                "name": "terraformId",
                "value": "",
                "type": "path",
                "description": "Terraform ID"
              }
            ]
          },
          "docs": "Returns list of the last 100 commits made on the repository linked to the terraform service"
        }
      ]
    }
  ],
  "bundled": true
}