{
  "opencollection": "1.0.0",
  "info": {
    "name": "Qovery Account Info Environment Actions API",
    "version": "1.0.4"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Environment Actions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Deploy environment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.qovery.com/environment/:environmentId/deploy",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "Environment ID"
              }
            ]
          },
          "docs": "This will deploy all the services of this environment to their latest version."
        },
        {
          "info": {
            "name": "Uninstall environment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.qovery.com/environment/:environmentId/uninstall",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "This will uninstall all the services of this environment."
        },
        {
          "info": {
            "name": "Stop environment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.qovery.com/environment/:environmentId/stop",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "Environment ID"
              }
            ]
          },
          "docs": "Stop environment"
        },
        {
          "info": {
            "name": "Redeploy environment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.qovery.com/environment/:environmentId/redeploy",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "Environment ID"
              }
            ]
          },
          "docs": "Redeploy environment"
        },
        {
          "info": {
            "name": "Cancel environment deployment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.qovery.com/environment/:environmentId/cancelDeployment",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "Environment ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Cancel the current deployment of your environment."
        },
        {
          "info": {
            "name": "Clone environment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.qovery.com/environment/:environmentId/clone",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "Environment ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "You must provide a name. This will create a new environment, with the same configuration, and same applications and databases. Database data is not cloned."
        },
        {
          "info": {
            "name": "Deploy services",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.qovery.com/environment/:environmentId/service/deploy",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "Environment ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update and deploy the selected services"
        },
        {
          "info": {
            "name": "Reboot services",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.qovery.com/environment/:environmentId/service/restart-service",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "Environment ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update and reboot the selected services"
        },
        {
          "info": {
            "name": "Stop services",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.qovery.com/environment/:environmentId/service/stop",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "Environment ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Stop selected services"
        },
        {
          "info": {
            "name": "Delete services",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.qovery.com/environment/:environmentId/service/delete",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "Environment ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Delete selected services"
        },
        {
          "info": {
            "name": "Uninstall services",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.qovery.com/environment/:environmentId/service/uninstall",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "uninstall selected services"
        },
        {
          "info": {
            "name": "Clean failed jobs within an environment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.qovery.com/environment/:environmentId/cleanFailedJobs",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Clean failed jobs within an environment"
        }
      ]
    }
  ],
  "bundled": true
}