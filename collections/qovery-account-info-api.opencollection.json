{
  "opencollection": "1.0.0",
  "info": {
    "name": "Qovery Account Info API",
    "version": "1.0.4"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account Info",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Account information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.qovery.com/account"
          },
          "docs": "Get Account information"
        },
        {
          "info": {
            "name": "Edit account information",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.qovery.com/account",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Edit account information"
        }
      ]
    }
  ],
  "bundled": true
}