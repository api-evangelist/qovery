{
  "opencollection": "1.0.0",
  "info": {
    "name": "Qovery Account Info Terraforms API",
    "version": "1.0.4"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Terraforms",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List terraforms",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.qovery.com/environment/:environmentId/terraform",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List terraforms"
        },
        {
          "info": {
            "name": "Create a terraform",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.qovery.com/environment/:environmentId/terraform",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a terraform"
        },
        {
          "info": {
            "name": "List default terraform advanced settings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.qovery.com/defaultTerraformAdvancedSettings"
          },
          "docs": "List default terraform advanced settings"
        },
        {
          "info": {
            "name": "Clone terraform",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.qovery.com/terraform/:terraformId/clone",
            "params": [
              {
                "name": "terraformId",
                "value": "",
                "type": "path",
                "description": "Terraform ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This will create a new terraform with the same configuration on the targeted environment Id."
        }
      ]
    }
  ],
  "bundled": true
}