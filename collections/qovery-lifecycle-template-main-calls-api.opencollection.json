{
  "opencollection": "1.0.0",
  "info": {
    "name": "Qovery Account Info Lifecycle Template Main Calls API",
    "version": "1.0.4"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Lifecycle Template Main Calls",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List available lifecycle template for this environment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.qovery.com/environment/:environmentId/lifecycleTemplate",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List available lifecycle template for this environment"
        },
        {
          "info": {
            "name": "Get specific lifecycle template",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.qovery.com/environment/:environmentId/lifecycleTemplate/:lifecycleTemplateId",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "lifecycleTemplateId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get specific lifecycle template"
        }
      ]
    }
  ],
  "bundled": true
}