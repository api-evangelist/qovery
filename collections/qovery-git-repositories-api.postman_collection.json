          "name": "List directories from a git repository",
          "request": {
            "name": "List directories from a git repository",
            "description": {
              "content": "List immediate subdirectories at a specified path in a git repository.\nThis endpoint is used when creating Terraform services to help users browse\nand select the appropriate root path.\n",
